# Lean build output — reproducible from lean-toolchain + lake-manifest.json
/.lake

# Participants' own work: ignored so that `git pull` can never conflict.
# The README is kept so the folder exists in a fresh clone.
/MyWork/*
!/MyWork/README.md

# Instructor scratch: drafts of session material that are not ready to ship.
# Ignored entirely, so nothing half-written is ever public.
/snippets/

# Files the Claude desktop app drops in the working folder. Nothing in here
# belongs in the repository; finished material is written to its session
# folder directly.
/Claude outputs/
